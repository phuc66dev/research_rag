DATABASE_URL=sqlite:///./data/edurag.db
ENABLE_MOCK_CHAT=true
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
DOCUMENT_STORAGE_DIR=./data/documents
DOCUMENT_MAX_BYTES=52428800
DOCUMENT_MAX_PAGES=500
DOCUMENT_MAX_CHUNKS=5000
DOCUMENT_MAX_PER_WORKSPACE=10
DOCUMENT_WORKER_ENABLED=true
DOCUMENT_JOB_TIMEOUT=600
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_CACHE_DIR=./data/models
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=2048
# Ollama local (no cloud API key):
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen2.5:3b
# LLM_API_KEY=ollama
# If the local GPU runner fails, create a model from backend/ollama/Modelfile.cpu and use:
# LLM_MODEL=edurag-qwen2.5-cpu:latest
# Keys stay server-side. Do not prefix secrets with VITE_.
# GEMINI_API_KEY=
# GROQ_API_KEY=
# QDRANT_URL=http://localhost:6333
